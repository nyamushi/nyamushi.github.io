# ==========================================================================
#  说明：GitHub Pages 会把这个仓库原样发布到公网，
#       所以下面这些「不该公开」或「不需要公开」的内容一律排除。
# ==========================================================================

# 简历：含手机号与邮箱，公开仓库不发布（招聘爬虫会抓取）
# 面试时单独发给 HR 即可。
resume.docx

# 自检截图与临时产物
_qa/
node_modules/
package-lock.json
*.log
*.tmp

# 系统 / 编辑器
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# 原始素材（35MB，占仓库 85%）：
#   GitHub Pages 只需要 index.html + assets/，原始图并不参与线上展示，
#   体积过大会导致网页上传失败（>25MB）或 push 极慢。
#   素材请在本机保留；换电脑时把 raw-src 单独拷走即可。
raw-src/

# 仓库里已有压缩后的成品图，重新生成时才需要 raw-src：
#   把素材放回 raw-src/ 后运行  & tools/build-assets.ps1
